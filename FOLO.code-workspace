{
  "folders": [
    {
      "path": ".",
      "name": "📁 FOLO (Root)"
    },
    {
      "path": "android",
      "name": "🤖 Android App"
    },
    {
      "path": "web",
      "name": "🌐 Web App"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.gradle": true,
      "**/node_modules": true,
      "**/.next": true,
      "**/.DS_Store": true
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "[kotlin]": {
      "editor.defaultFormatter": "fwcd.kotlin"
    }
  },
  "extensions": {
    "recommendations": [
      "kotlinlang.kotlin",
      "google.android-ndk-manager",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "bradlc.vscode-tailwindcss",
      "ms-vscode.vscode-typescript-next",
      "firsttris.vscode-jest-runner",
      "eamodio.gitlens",
      "github.vscode-github-actions"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "🌐 Web: Attach to Chrome",
        "type": "chrome",
        "request": "attach",
        "port": 9222,
        "pathMapping": {
          "/": "${workspaceFolder}/web/",
          "/src": "${workspaceFolder}/web/src/"
        }
      },
      {
        "name": "🌐 Web: Launch in Chrome",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:3000",
        "webRoot": "${workspaceFolder}/web"
      }
    ]
  }
}
